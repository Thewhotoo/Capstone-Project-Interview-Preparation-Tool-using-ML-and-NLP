# Optional settings for `docker compose up`. Copy to `.env` (not in git) and
# change what you need; everything has a working default.

# Port on this machine the app is served on (http://localhost:5000).
CAP_PORT=5000

# Database password. Change it BEFORE the first `docker compose up`: PostgreSQL
# sets it only when its volume is first created.
POSTGRES_PASSWORD=cap

# Login-cookie key. Leave empty to have one generated and kept in the app's
# volume. Set it (a long random string) when running more than one app server.
CAP_SECRET_KEY=

# Requests the server handles at once.
CAP_THREADS=8
