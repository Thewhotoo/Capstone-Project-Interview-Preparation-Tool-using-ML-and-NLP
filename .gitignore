# interview reads question_bank/) ---
rag_system/rag_tester/knowledge_base/
rag_system/rag_tester/knowledge_base_v2/

# --- resumable caches of the offline question generation / enrichment ---
rag_system/rag_tester/.qbank_cache/
rag_system/rag_tester/.enrich_cache/

